# ============================================================
# 生产环境配置模板 —— 复制为 .env 后逐项填写
#   cp .env.production.example .env && vim .env
# 填完执行 ./scripts/deploy.sh（内置生产门预检，缺项/弱项会拒绝部署）
# ============================================================

# --- PostgreSQL（compose 直接读取，:? 缺失拒绝启动）---
# 至少 12 位强密码：openssl rand -base64 18
POSTGRES_PASSWORD=

# --- 构建参数（国内服务器建议 npmmirror 提速；海外默认即可）---
# NPM_REGISTRY=https://registry.npmmirror.com

# --- 对外地址（必须是用户浏览器实际访问的 HTTPS 源）---
# 例：https://manga.example.com（不带尾斜杠用于邮件链接）
CORS_ORIGINS=https://manga.example.com
PUBLIC_APP_URL=https://manga.example.com

# --- 运行环境（deploy.sh 预检强制以下三项）---
NODE_ENV=production
# 邮箱验证与限流绝不可在生产旁路（任何 true 都是安全漏洞）
EMAIL_VERIFICATION_DISABLED=false
RATE_LIMIT_DISABLED=false
# NODE_ENV=production 时 Cookie 默认 Secure。证书就绪前的 HTTP 过渡期
# 可临时设 COOKIE_SECURE=false（否则浏览器不回传会话 Cookie，无法登录）；
# 切换 HTTPS 后必须改回 true 并重启
COOKIE_SECURE=true
# 登录/注册人机验证（自托管 SVG 图形验证码，零外部依赖）。生产必须 true
CAPTCHA_ENABLED=true

# --- 身份与公开安全 ---
# IP 审计哈希盐：openssl rand -hex 16
IP_HMAC_SALT=

# --- SMTP（生产必须真实发信，注册验证依赖它）---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@manga.example.com
# 邮件动作令牌封印密钥（32 字节 hex）：openssl rand -hex 32
EMAIL_DELIVERY_KEY=
EMAIL_DELIVERY_KEY_ID=v1

# --- 网关与部署密钥（缺失时服务端拒绝启动 fail-close）---
# 各自独立生成：openssl rand -hex 32
MODEL_ENC_KEY=
MODEL_ENC_KEY_ID=v1
REQUEST_HMAC_KEY=

# --- Argon2id（生产基线，勿调低）---
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# --- 自动备份（api 容器内置调度器；backups 卷持久化）---
BACKUP_INTERVAL_HOURS=24
BACKUP_INITIAL_DELAY_MS=600000
BACKUP_KEEP=14
BACKUP_DISABLED=false
# 强烈建议：age 公钥（age-keygen 生成）。设置后备份自动加密并删除明文。
BACKUP_AGE_RECIPIENT=

# --- 离线备份上传（scripts/backup-offsite.sh）---
# 启用后，定时/手动把加密后的 *.dump.age 推送到 S3 兼容存储（AWS S3 / MinIO / R2 / Aliyun OSS）
# 建议在部署机或单独调度机上配置 cron：0 3 * * * /app/scripts/backup-offsite.sh
BACKUP_OFFSITE_ENABLED=true
BACKUP_OFFSITE_PROVIDER=s3
BACKUP_OFFSITE_ENDPOINT=https://s3.example.com
BACKUP_OFFSITE_BUCKET=manga-studio-backups
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BACKUP_OFFSITE_REGION=us-east-1
BACKUP_OFFSITE_RETENTION_DAYS=90
BACKUP_OFFSITE_STORAGE_CLASS=STANDARD

# --- 初始管理员（密码在受保护终端交互输入，绝不写入 env）---
BOOTSTRAP_ADMIN_EMAIL=admin@manga.example.com

# --- 可选：前端宿主端口（health-check/deploy 冒烟用，默认 3005）---
# PUBLIC_PORT=3005

# --- Alertmanager 告警通道（生产建议配置）---
# SMTP 发信（用于邮件告警）
# ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
# ALERTMANAGER_SMTP_FROM=alerts@manga-studio.local
# ALERTMANAGER_SMTP_USER=alerts@manga-studio.local
# ALERTMANAGER_SMTP_PASSWORD=
# 告警接收邮箱
# ALERTMANAGER_DEFAULT_EMAIL=ops@manga-studio.local
# ALERTMANAGER_CRITICAL_EMAIL=oncall@manga-studio.local
# ALERTMANAGER_WARNING_EMAIL=team@manga-studio.local
# Webhook 通知（Slack/DingTalk/钉钉/企业微信等，需自行部署接收服务）
# ALERTMANAGER_WEBHOOK_DEFAULT=http://host.docker.internal:5000/webhook/alerts
# ALERTMANAGER_WEBHOOK_CRITICAL=http://host.docker.internal:5000/webhook/alerts-critical
