# ============================================================
# 生产环境配置模板 —— 复制为 .env 后逐项填写
#   cp .env.production.example .env && vim .env
# 填完执行 ./scripts/deploy.sh（内置生产门预检，缺项/弱项会拒绝部署）
# ============================================================

# --- PostgreSQL（compose 直接读取，:? 缺失拒绝启动）---
# 至少 12 位强密码：openssl rand -base64 18
POSTGRES_PASSWORD=

# --- 对外地址（必须是用户浏览器实际访问的 HTTPS 源）---
# 例：https://manga.example.com（不带尾斜杠用于邮件链接）
CORS_ORIGINS=https://manga.example.com
PUBLIC_APP_URL=https://manga.example.com

# --- 运行环境（deploy.sh 预检强制以下三项）---
NODE_ENV=production
# 邮箱验证与限流绝不可在生产旁路（任何 true 都是安全漏洞）
EMAIL_VERIFICATION_DISABLED=false
RATE_LIMIT_DISABLED=false
# NODE_ENV=production 时 Cookie 自动 Secure；显式写出更清晰
COOKIE_SECURE=true

# --- 身份与公开安全 ---
# IP 审计哈希盐：openssl rand -hex 16
IP_HMAC_SALT=

# --- SMTP（生产必须真实发信，注册验证依赖它）---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@manga.example.com
# 邮件动作令牌封印密钥（32 字节 hex）：openssl rand -hex 32
EMAIL_DELIVERY_KEY=
EMAIL_DELIVERY_KEY_ID=v1

# --- 网关与部署密钥（缺失时服务端拒绝启动 fail-close）---
# 各自独立生成：openssl rand -hex 32
MODEL_ENC_KEY=
MODEL_ENC_KEY_ID=v1
REQUEST_HMAC_KEY=

# --- Argon2id（生产基线，勿调低）---
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# --- 自动备份（api 容器内置调度器；backups 卷持久化）---
BACKUP_INTERVAL_HOURS=24
BACKUP_INITIAL_DELAY_MS=600000
BACKUP_KEEP=14
BACKUP_DISABLED=false
# 强烈建议：age 公钥（age-keygen 生成）。设置后备份自动加密并删除明文。
BACKUP_AGE_RECIPIENT=

# --- 初始管理员（密码在受保护终端交互输入，绝不写入 env）---
BOOTSTRAP_ADMIN_EMAIL=admin@manga.example.com

# --- 可选：前端宿主端口（health-check/deploy 冒烟用，默认 3005）---
# PUBLIC_PORT=3005
