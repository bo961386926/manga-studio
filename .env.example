# API Key for AI services
ANTSK_API_KEY=your_api_key_here

# PostgreSQL (for local development / docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manga_studio
DB_USER=postgres
DB_PASSWORD=postgres

# --- Identity & public security (stage 1) ---
NODE_ENV=development
# Exact comma-separated browser origins allowed for CORS + anonymous mutations.
# Production must pin the real HTTPS origin; never '*' and never dynamic echo.
CORS_ORIGINS=http://localhost:5173
# Canonical public URL used in email links and security decisions.
PUBLIC_APP_URL=http://localhost:3001
# Cookie Secure flag (auto-enabled when NODE_ENV=production).
COOKIE_SECURE=false
# Salt for HMAC-ing IP audit values (never a plain hash).
IP_HMAC_SALT=change-me

# --- SMTP outbox worker ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# 32-byte hex key sealing action tokens in the email outbox (production required)
EMAIL_DELIVERY_KEY=
EMAIL_DELIVERY_KEY_ID=v1

# --- Argon2id tuning (production baseline: memory 64MiB, iterations 3, parallelism 1) ---
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Bootstrap admin email (password always via protected terminal prompt,
# never a plaintext env var).
BOOTSTRAP_ADMIN_EMAIL=

# --- Automatic database backups ---
# Interval in hours between automatic pg_dump snapshots (default 24).
BACKUP_INTERVAL_HOURS=24
# Delay in ms before the first scheduled backup after server start (default 10 min).
BACKUP_INITIAL_DELAY_MS=600000
# How many snapshot files to keep (default 14).
BACKUP_KEEP=14
# Set true to disable the scheduler (e.g. ephemeral dev).
BACKUP_DISABLED=false
